@model EquipmentDetailViewModel
@{
    ViewData["Title"] = Model.Equipment?.EquipmentCode ?? "Equipment Details";
}

<partial name="_DatasetSourceBanner" model="Model.DatasetStatus" />
<partial name="_DatasetValidationErrors" model="Model.DatasetStatus" />

@if (Model.DatasetStatus.IsValid)
{
    if (Model.Equipment is null)
    {
        <div class="alert alert-warning" role="alert">
            Equipment <strong>@Model.NotFoundCode</strong> was not found in the Rolling Mill dataset.
        </div>
        <a asp-action="Index" class="btn btn-outline-primary">Back to equipment list</a>
    }
    else
    {
        var e = Model.Equipment;
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="h4 mb-1">@e.EquipmentCode</h2>
                <p class="text-muted mb-0">@e.EquipmentTypeKey · @e.Section · @e.PlantName</p>
            </div>
            <span class="badge risk-@e.RiskLevel.ToLowerInvariant() fs-6">@e.RiskLevel</span>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-header"><h3 class="h6 mb-0">Condition & recommendations</h3></div>
                    <div class="panel-body small">
                        <dl class="row mb-0">
                            <dt class="col-6">Observed at</dt><dd class="col-6">@e.ObservedAtLocal.ToString("yyyy-MM-dd HH:mm")</dd>
                            <dt class="col-6">Health score</dt><dd class="col-6">@e.HealthScore.ToString("F2")</dd>
                            <dt class="col-6">Maintenance flag</dt><dd class="col-6">@e.MaintenanceRecommendation</dd>
                            <dt class="col-6">Est. downtime (tier)</dt><dd class="col-6">@e.EstimatedDowntimeHours.ToString("F0") h</dd>
                            <dt class="col-6">Est. cost (tier)</dt><dd class="col-6">₹@e.EstimatedCostImpactInr.ToString("N0")</dd>
                            <dt class="col-6">Failures (last year)</dt><dd class="col-6">@e.FailureCountLastYear.ToString("F0")</dd>
                            <dt class="col-6">Days since maint.</dt><dd class="col-6">@e.MaintenanceDaysAgo.ToString("F0")</dd>
                        </dl>
                        <p class="text-muted mt-3 mb-0">Risk labels and estimates are dataset fields, not confirmed events.</p>
                        @if (Model.MachineLearningPrediction is { } ml)
                        {
                            <hr />
                            <h4 class="h6">ML risk prediction (separate from dataset label)</h4>
                            <dl class="row mb-0">
                                <dt class="col-6">Predicted risk</dt>
                                <dd class="col-6"><span class="badge risk-@ml.PredictedRiskLevel.ToLowerInvariant()">@ml.PredictedRiskLevel</span></dd>
                                <dt class="col-6">Dataset risk</dt>
                                <dd class="col-6">@ml.DatasetRiskLevel</dd>
                                <dt class="col-6">Confidence</dt>
                                <dd class="col-6">@ml.Confidence.ToString("P1")</dd>
                                <dt class="col-6">Matches dataset</dt>
                                <dd class="col-6">@(ml.MatchesDatasetLabel ? "Yes" : "No")</dd>
                            </dl>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-header"><h3 class="h6 mb-0">Operating measurements</h3></div>
                    <div class="panel-body small">
                        <dl class="row mb-0">
                            <dt class="col-7">Motor temp</dt><dd class="col-5">@e.MotorTempC.ToString("F1") °C</dd>
                            <dt class="col-7">Bearing temp</dt><dd class="col-5">@e.BearingTempC.ToString("F1") °C</dd>
                            <dt class="col-7">Vibration</dt><dd class="col-5">@e.VibrationMmS.ToString("F2") mm/s</dd>
                            <dt class="col-7">Motor current</dt><dd class="col-5">@e.MotorCurrentA.ToString("F0") A</dd>
                            <dt class="col-7">Power</dt><dd class="col-5">@e.PowerKw.ToString("F0") kW</dd>
                            <dt class="col-7">Operating hours</dt><dd class="col-5">@e.OperatingHours.ToString("F0")</dd>
                            <dt class="col-7">Roll speed</dt><dd class="col-5">@e.RollSpeedMpm.ToString("F0") m/min</dd>
                            <dt class="col-7">Roll force</dt><dd class="col-5">@e.RollForceKn.ToString("F0") kN</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-header"><h3 class="h6 mb-0">Energy & production</h3></div>
                    <div class="panel-body small">
                        <dl class="row mb-0">
                            <dt class="col-7">Energy</dt><dd class="col-5">@e.EnergyKwh.ToString("N0") kWh</dd>
                            <dt class="col-7">Production</dt><dd class="col-5">@e.ProductionTons.ToString("F0") tons</dd>
                            <dt class="col-7">Energy intensity</dt><dd class="col-5">@e.EnergyIntensityKwhPerTon.ToString("F2") kWh/ton</dd>
                            <dt class="col-7">Hydraulic pressure</dt><dd class="col-5">@e.HydraulicPressureBar.ToString("F0") bar</dd>
                            <dt class="col-7">Oil pressure</dt><dd class="col-5">@e.OilPressureBar.ToString("F1") bar</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
            <a asp-controller="Alerts" asp-action="Index" class="btn btn-outline-primary">View dataset alerts</a>
        </div>
    }
}
