@{
    var pageTitle = ViewData["PageTitle"]?.ToString() ?? "AssetIQ";
}
<header class="app-topbar">
    <div>
        <h1 class="topbar-title">@pageTitle</h1>
        <p class="topbar-subtitle mb-0">Manufacturing reliability, maintenance, and energy analytics</p>
    </div>
    <div class="topbar-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="small text-muted">@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">Sign in</a>
        }
    </div>
</header>
